{
  "name": "escorpio-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-desk.ts",
    "check:deposit": "node scripts/check-deposit.ts",
    "check:borrow": "node scripts/check-borrow.ts",
    "test": "npm run check && npm run check:mcp && npm run check:deposit && npm run check:borrow && npm run check:stats && npm run check:receive && npm run check:agent && npm run check:onchain && echo 'all tests passed: desk, mcp, deposit, borrow, stats, receive, agent, onchain'",
    "preview:pages": "npx wrangler pages dev dist --port 4401 --compatibility-date 2026-11-01",
    "check:mcp": "node scripts/check-mcp.ts",
    "check:receive": "node scripts/check-receive.ts",
    "check:onchain": "node scripts/check-onchain.ts",
    "check:agent": "node scripts/check-agent.ts",
    "check:stats": "node scripts/check-stats.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "viem": "^2.58.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
